      <column caption="city_category_summary.csv" datatype="table" name="[__tableau_internal_object_id__].[city_category_summary.csv_A1B2C3D4E5F64789A0B1C2D3E4F50617]" role="measure" type="quantitative" />
      <column caption="City" datatype="string" name="[city]" role="dimension" type="nominal" />
      <column caption="Category" datatype="string" name="[category]" role="dimension" type="nominal" />
      <column caption="Bookings" datatype="integer" default-format="#,##0" name="[bookings_count]" role="measure" type="quantitative" />
      <column caption="Revenue INR" datatype="integer" default-format="₹#,##0" name="[revenue_inr]" role="measure" type="quantitative" />
      <column caption="SLA Breaches" datatype="integer" default-format="#,##0" name="[sla_breaches]" role="measure" type="quantitative" />
      <column caption="SLA Breach Rate" datatype="real" default-format="0.0%" name="[Calculation_SLABreachRate]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([sla_breaches]) / SUM([bookings_count])" />
      </column>
      <column caption="Month Focus Label" datatype="string" name="[Calculation_MonthFocusLabel]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[Parameters].[Month Focus]" />
      </column>
      <column caption="City Latitude" datatype="real" name="[Calculation_CityLatitude]" role="measure" semantic-role="[Geographical].[Latitude]" type="quantitative">
        <calculation class="tableau" formula="CASE [city] WHEN &quot;Bengaluru&quot; THEN 12.9716 WHEN &quot;Mumbai&quot; THEN 19.076 WHEN &quot;Delhi NCR&quot; THEN 28.6139 WHEN &quot;Pune&quot; THEN 18.5204 WHEN &quot;Hyderabad&quot; THEN 17.385 WHEN &quot;Chennai&quot; THEN 13.0827 END" />
      </column>
      <column caption="City Longitude" datatype="real" name="[Calculation_CityLongitude]" role="measure" semantic-role="[Geographical].[Longitude]" type="quantitative">
        <calculation class="tableau" formula="CASE [city] WHEN &quot;Bengaluru&quot; THEN 77.5946 WHEN &quot;Mumbai&quot; THEN 72.8777 WHEN &quot;Delhi NCR&quot; THEN 77.209 WHEN &quot;Pune&quot; THEN 73.8567 WHEN &quot;Hyderabad&quot; THEN 78.4867 WHEN &quot;Chennai&quot; THEN 80.2707 END" />
      </column>
      <drill-paths>
        <drill-path name="City to Category">
          <field>[city]</field>
          <field>[category]</field>
        </drill-path>
      </drill-paths>
    </datasource>
